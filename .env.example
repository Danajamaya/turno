# Copy to apps/web/.env.local and fill in. Never commit real values.

# Postgres (Supabase: Project Settings > Database > Connection string, "Session" pooler)
DATABASE_URL=
DATABASE_POOL_MAX=10

# Public URL of the app, used in emailed links
APP_URL=http://localhost:3100

# Email (Resend). Without a key, emails are written to apps/web/.data/outbox.jsonl
RESEND_API_KEY=
EMAIL_FROM=Turno <hola@tu-dominio.com>

# Stripe, test mode first (sk_test_..., whsec_...). Prices are recurring, per location.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ESSENTIALS=
STRIPE_PRICE_PLUS=

# Development only: enables /dev/login (sign in as anyone). Never set in production.
TURNO_DEV_LOGIN=

# Inbound booking emails (guides): the mail provider posts each email to
# /api/inbound/email with this shared secret in the x-inbound-secret header.
INBOUND_SECRET=
INBOUND_DOMAIN=reservas.tu-dominio.com

# Signs public links (tip QR codes). Any long random string; required in production.
LINK_SECRET=

# Weekly summary: the scheduler calls GET /api/cron/weekly with "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=

# Push notifications to the installed app. Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hola@tu-dominio.com

# Optional: suggested replies to traveller questions written by Claude.
# Without it, suggestions come from the business's own tour data.
ANTHROPIC_API_KEY=

# Optional: WhatsApp Business Cloud API (Meta). Webhook URL: https://<domain>/api/whatsapp
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
